PORT=5000
NODE_ENV=development

# Allowed origins for CORS and secure cookies (comma-separated if multiple)
CLIENT_URL=http://localhost:8443,http://localhost:5173

# MongoDB Atlas or local database connection URI
MONGO_URI=mongodb://127.0.0.1:27017/sthavya_spaces

# JWT Authentication
JWT_SECRET=sthavyaspaces_jwt_secret_production_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Backend only - never expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional Cloudinary configuration (Defaults to MongoDB GridFS if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
